# ====================================================================
# InterviewIQ Environment Variables
# ====================================================================

# Port configuration
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider API Keys (Server-Side)
# Supports Google Gemini API (gemini-1.5-flash / gemini-2.0-flash)
# Or OpenAI API (gpt-4o / gpt-4o-mini)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Supabase Configuration (Optional - falls back to robust local persistent store automatically)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret for Session Management
JWT_SECRET=interview_iq_super_secret_jwt_key_2026
